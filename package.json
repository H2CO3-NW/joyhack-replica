{
  "name": "joyhack-replica",
  "version": "0.9.0",
  "description": "JoyHack Karaoke Player Engine and Web Server",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux AppImage --x64",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "express": "^4.22.2",
    "iconv-lite": "^0.6.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.joyhack.replica",
    "productName": "JoyHack Player",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!Songs/**/*",
      "!server-stable.js",
      "!public/admin-stable.html"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "executableName": "joyhack-player"
    },
    "win": {
      "target": [
        "zip",
        "portable"
      ],
      "sign": null,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
